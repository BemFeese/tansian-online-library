# Copy this file to a new file named ".env" (same folder) and edit the values.
# If your password contains a # character, wrap it in double quotes: DB_PASSWORD="pa#ss"

PORT=3000
NODE_ENV=development

# --- MySQL connection (use the password you chose when installing MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=library_db

# --- Security: any long random text (16+ characters). Change it before going live. ---
JWT_SECRET=change-this-to-a-long-random-string
# Keep false while you run the site over http (localhost or your school network).
# Set to true only when the site is served over https, otherwise nobody will be able to sign in.
COOKIE_SECURE=false

# --- Online lending rules ---
# LOAN_DAYS = how many days a borrower can read the book before access ends by itself.
# MAX_BOOKS = how many books one person can have borrowed at the same time.
STUDENT_LOAN_DAYS=14
STUDENT_MAX_BOOKS=5
TEACHER_LOAN_DAYS=30
TEACHER_MAX_BOOKS=10

# --- Largest book file the librarian can upload, in megabytes ---
MAX_UPLOAD_MB=50


# First-time setup: leave the administrator details out of this file.
# The first librarian creates their own administrator account in the browser.
# INITIAL_ADMIN_* is no longer required for normal handover/setup.
