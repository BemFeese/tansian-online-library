{
  "name": "library-book-management-backend",
  "version": "3.0.0",
  "description": "Web-based library book management system (backend API and static file server), MySQL edition with online lending of digital books",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "setup": "node scripts/setup-db.js",
    "reset": "node scripts/setup-db.js --reset",
    "admin:create": "node scripts/setup-admin.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.0",
    "mysql2": "^3.11.0"
  }
}
